@page "/unities/edit/{Id:int}"
@using CompenseAgora.Models
@using CompenseAgora.Services.Interfaces
@rendermode InteractiveServer
@inject IUnityService UnityService
@inject NavigationManager NavigationManager

<h3>Editar Unidade</h3>

@if (Model == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="name" class="form-label">Nome:</label>
            <InputText id="name" class="form-control" @bind-Value="Model.Name" />
            <ValidationMessage For="@(() => Model.Name)" />
        </div>

        <button type="submit" class="btn btn-primary">Salvar</button>
        <a href="/unities" class="btn btn-secondary">Cancelar</a>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private UnityModel Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Model = await UnityService.GetByIdAsync(Id);
    }

    private async Task HandleValidSubmit()
    {
        await UnityService.UpdateAsync(Model);
        NavigationManager.NavigateTo("/unities");
    }
}